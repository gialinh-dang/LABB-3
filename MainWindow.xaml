<Window x:Class="LABB_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:LABB_3.View"
        Title="{Binding ActivePack.Name, StringFormat='Math Quiz - {0}', FallbackValue='Math Quiz'}"
        Height="760" Width="1240" MinHeight="620" MinWidth="1100"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewPackCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding ImportCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding PackOptionsCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PlayCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding EditModeCommand}"/>
        <KeyBinding Key="Insert" Command="{Binding ConfigurationViewModel.AddQuestionCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ExitFullScreenCommand}"/>
    </Window.InputBindings>
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                    <Setter Property="WindowStyle" Value="None"/>
                    <Setter Property="WindowState" Value="Maximized"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid Background="{StaticResource SkyBrush}">
        <Path Fill="#B5E59A" Stretch="Fill" Height="170" VerticalAlignment="Bottom"
              Data="M0,80 C200,0 400,0 600,60 C800,120 900,40 1000,50 L1000,170 L0,170 Z"/>
        <Path Fill="#8FD46F" Stretch="Fill" Height="110" VerticalAlignment="Bottom"
              Data="M0,60 C250,0 450,90 700,30 C850,0 950,20 1000,40 L1000,110 L0,110 Z"/>

        <DockPanel>
            <view:MenuView DockPanel.Dock="Top"/>
            <Grid Margin="24,16,24,24">
                <view:ConfigurationView DataContext="{Binding ConfigurationViewModel}"
                                        Visibility="{Binding Main.IsConfigurationMode, Converter={StaticResource BoolToVis}}"/>
                <view:PlayerView DataContext="{Binding PlayerViewModel}"
                                 Visibility="{Binding Main.IsPlayMode, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>