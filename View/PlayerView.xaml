<UserControl x:Class="LABB_3.View.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Grid>

        <!-- ===================== PLAYING ===================== -->
        <Grid MaxWidth="900" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar: home button, progress, timer -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource IconButton}" Width="52" Height="52" Background="White"
                        ToolTip="Back to edit mode" Command="{Binding BackToMenuCommand}">
                    <fa:IconBlock Icon="House" FontSize="22" Foreground="{StaticResource BlueBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Width="320" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavyBrush}">
                        <Run Text="Question"/>
                        <Run Text="{Binding QuestionNumber, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalQuestions, Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Height="16" Margin="0,8,0,0" Foreground="{StaticResource GreenBrush}"
                                 Maximum="{Binding TotalQuestions}" Value="{Binding QuestionNumber, Mode=OneWay}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="White" CornerRadius="8">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                Background="{TemplateBinding Foreground}" CornerRadius="8"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>

                <Border Grid.Column="2" Background="White" CornerRadius="26" Padding="18,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Stopwatch" FontSize="22" Foreground="{StaticResource OrangeBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TimeText}" FontSize="22" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimeLow}" Value="True">
                                            <Setter Property="Foreground" Value="#E5484D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Question card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="30,20">
                <StackPanel>
                    <Border Background="#FFF3C4" CornerRadius="14" Padding="14,4" HorizontalAlignment="Center">
                        <TextBlock Text="Pick the right answer!" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentQuestion.Query}" Margin="0,12,0,0"
                               FontSize="36" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 4 answer buttons in a 2x2 grid -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Answers}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PillButton}" Background="{Binding Color}" Opacity="{Binding Opacity}"
                                Margin="10" MinHeight="80"
                                Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <TextBlock Text="{Binding Text}" FontSize="26" FontWeight="Bold" Margin="40,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <fa:IconBlock Icon="CircleCheck" FontSize="30" HorizontalAlignment="Right"
                                              Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVis}}"/>
                                <fa:IconBlock Icon="CircleXmark" FontSize="30" HorizontalAlignment="Right"
                                              Visibility="{Binding ShowCross, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3" Text="{Binding FeedbackText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
        </Grid>

        <!-- ===================== RESULT ===================== -->
        <StackPanel Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">

            <fa:IconBlock Icon="Trophy" FontSize="110" Foreground="#FFC531" HorizontalAlignment="Center"/>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="30">
                <StackPanel>
                    <TextBlock Text="Quiz Completed!" FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                    <Border Background="#FFF1B8" CornerRadius="20" Padding="40,6" Margin="0,14" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ScoreText}" FontSize="48" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:IconBlock Icon="Star" Foreground="#FFC531" FontSize="22"/>
                        <TextBlock Text="{Binding ResultMessage}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" Margin="10,0"/>
                        <fa:IconBlock Icon="Star" Foreground="#FFC531" FontSize="22"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,24,0,0">
                <Button Style="{StaticResource PillButton}" Margin="0,0,8,0" Command="{Binding PlayAgainCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="RotateRight" Margin="0,0,8,0"/>
                        <TextBlock Text="Play Again"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Background="{StaticResource PurpleBrush}" Margin="8,0,0,0"
                        Command="{Binding BackToMenuCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="House" Margin="0,0,8,0"/>
                        <TextBlock Text="Menu"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>