<UserControl x:Class="LABB_3.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <UserControl.Resources>
        <!-- Big round button for the start page -->
        <Style x:Key="HomeButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="38"
                                BorderBrush="#99FFFFFF" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#4A6FA5" Opacity="0.3" BlurRadius="16" ShadowDepth="5" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small shadow under the white text on the buttons -->
        <DropShadowEffect x:Key="TextShadow" Color="#000000" Opacity="0.2" BlurRadius="4" ShadowDepth="2" Direction="270"/>
    </UserControl.Resources>

    <Grid>
        <!-- ===== Decoration: clouds and stars (only for looks) ===== -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,30,0,0" Opacity="0.9" IsHitTestVisible="False">
            <Ellipse Width="180" Height="60" Fill="White" VerticalAlignment="Bottom"/>
            <Ellipse Width="90" Height="80" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,12"/>
            <Ellipse Width="70" Height="60" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,16"/>
        </Grid>
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,40,0" Opacity="0.9" IsHitTestVisible="False">
            <Ellipse Width="200" Height="64" Fill="White" VerticalAlignment="Bottom"/>
            <Ellipse Width="100" Height="88" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,12"/>
            <Ellipse Width="76" Height="64" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,18"/>
        </Grid>

        <!-- Big soft cloud behind the buttons -->
        <Ellipse Width="760" Height="420" Fill="White" Opacity="0.35" VerticalAlignment="Bottom"
                 Margin="0,0,0,-120" IsHitTestVisible="False"/>

        <fa:IconBlock Icon="Star" FontSize="36" Foreground="#FFD84D" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="190,0,0,120"/>
        <fa:IconBlock Icon="Star" FontSize="30" Foreground="#FFD84D" IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,110,0"/>
        <fa:IconBlock Icon="Star" FontSize="26" Foreground="#FFD84D" IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,120,200,0"/>

        <!-- ===== Title + buttons ===== -->
        <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Title in a white "cloud" -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                <Border Background="#EBFFFFFF" CornerRadius="50" Padding="44,6,44,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#4A6FA5" Opacity="0.2" BlurRadius="20" ShadowDepth="4" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Math" FontFamily="Segoe UI Black" FontSize="64"
                                   Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" Margin="0,0,0,-22"/>
                        <TextBlock Text="Adventure" FontFamily="Segoe UI Black" FontSize="58"
                                   Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Calculator icon in the top right corner of the title -->
                <fa:IconBlock Icon="Calculator" FontSize="58" Foreground="{StaticResource PurpleBrush}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-34,0">
                    <fa:IconBlock.RenderTransform>
                        <RotateTransform Angle="12"/>
                    </fa:IconBlock.RenderTransform>
                </fa:IconBlock>
            </Grid>

            <!-- Play: goes to the list of question packs -->
            <Button Style="{StaticResource HomeButton}" Command="{Binding ShowPacksCommand}"
                    ToolTip="Choose a question pack to play">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFD966" Offset="0"/>
                        <GradientStop Color="#FFB13D" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal" Effect="{StaticResource TextShadow}">
                    <fa:IconBlock Icon="Play" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Settings: goes to the Edit Question page -->
            <Button Style="{StaticResource HomeButton}" Command="{Binding OpenSettingsCommand}"
                    ToolTip="Edit the questions">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A9D4FF" Offset="0"/>
                        <GradientStop Color="#6AAAF5" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal" Effect="{StaticResource TextShadow}">
                    <fa:IconBlock Icon="Gear" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
