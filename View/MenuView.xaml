<UserControl x:Class="LABB_3.View.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Menu Background="#B3FFFFFF" Padding="8,4" FontSize="14" Foreground="{StaticResource NavyBrush}">

        <MenuItem Header="_File">
            <MenuItem Header="_New Question Pack" InputGestureText="Ctrl+N" Command="{Binding NewPackCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Plus" Width="14" Height="14" Foreground="{StaticResource BlueBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Delete Question Pack" Command="{Binding DeletePackCommand}">
                <MenuItem.Icon><fa:IconImage Icon="TrashCan" Width="14" Height="14" Foreground="{StaticResource PinkBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Import Questions" InputGestureText="Ctrl+I" Command="{Binding ImportCommand}">
                <MenuItem.Icon><fa:IconImage Icon="CloudArrowDown" Width="14" Height="14" Foreground="{StaticResource PurpleBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"/>
        </MenuItem>

        <MenuItem Header="_Edit">
            <MenuItem Header="_Add Question" InputGestureText="Insert" Command="{Binding ConfigurationViewModel.AddQuestionCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Plus" Width="14" Height="14" Foreground="{StaticResource BlueBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Remove Question" InputGestureText="Delete" Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Minus" Width="14" Height="14" Foreground="{StaticResource PinkBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pack _Options" InputGestureText="Ctrl+O" Command="{Binding PackOptionsCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Gear" Width="14" Height="14" Foreground="{StaticResource NavyBrush}"/></MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="_View">
            <MenuItem Header="_Play" InputGestureText="Ctrl+P" Command="{Binding PlayCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Play" Width="14" Height="14" Foreground="{StaticResource GreenBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Edit" InputGestureText="Ctrl+E" Command="{Binding EditModeCommand}">
                <MenuItem.Icon><fa:IconImage Icon="Pen" Width="14" Height="14" Foreground="{StaticResource PurpleBrush}"/></MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </Menu>
</UserControl>
