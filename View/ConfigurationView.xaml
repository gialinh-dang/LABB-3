<UserControl x:Class="LABB_3.View.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 1. Question Packs ===== -->
        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="14,6" FontSize="14"
                            Command="{Binding Main.NewPackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" Margin="0,0,6,0"/>
                            <TextBlock Text="New Pack"/>
                        </StackPanel>
                    </Button>
                    <fa:IconBlock Icon="BookOpen" FontSize="22" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Question Packs" Style="{StaticResource Heading}"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding Main.Packs}" SelectedItem="{Binding Main.ActivePack}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Background="{StaticResource GreenBrush}" ToolTip="Play (every question needs a text and 4 answers)" ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding DataContext.Main.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <fa:IconBlock Icon="Play"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Background="{StaticResource PurpleBrush}" ToolTip="Pack options"
                                            Command="{Binding DataContext.Main.PackOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <fa:IconBlock Icon="Pen"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Background="{StaticResource PinkBrush}" ToolTip="Delete pack"
                                            Command="{Binding DataContext.Main.DeletePackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <fa:IconBlock Icon="TrashCan"/>
                                    </Button>
                                </StackPanel>

                                <fa:IconBlock Icon="Book" FontSize="28" Foreground="{StaticResource OrangeBrush}"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource NavyBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}">
                                        <Run Text="{Binding Difficulty, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Questions.Count, Mode=OneWay}"/>
                                        <Run Text="questions"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 2. Questions in the active pack ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Add question (Insert)"
                            Command="{Binding AddQuestionCommand}">
                        <fa:IconBlock Icon="Plus"/>
                    </Button>
                    <fa:IconBlock Icon="ListUl" FontSize="20" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Questions" Style="{StaticResource Heading}"/>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Main.ActivePack.Name}" FontSize="13"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

                <ListBox ItemsSource="{Binding Main.ActivePack.Questions}" SelectedItem="{Binding ActiveQuestion}"
                         Background="Transparent" BorderThickness="0" FontSize="15"
                         Foreground="{StaticResource NavyBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Query}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 3. Edit Question ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
                    <fa:IconBlock Icon="Pen" FontSize="22" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Edit Question" Style="{StaticResource Heading}"/>
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FloppyDisk" Margin="0,0,8,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PillButton}"
                            Background="{StaticResource SoftPinkBrush}" Foreground="#E5484D"
                            Command="{Binding RemoveQuestionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="TrashCan" Margin="0,0,8,0"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Grid IsEnabled="{Binding HasActiveQuestion}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Question:" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,18"
                             Text="{Binding ActiveQuestion.Query, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Answers (select the correct one):" Style="{StaticResource Label}"/>

                    <RadioButton Grid.Row="3" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[0], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="4" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[1], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="5" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[2], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="6" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=3}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[3], UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" VerticalAlignment="Bottom" FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               Text="Tip: Insert = add question · Delete = remove question · Ctrl+O = pack options"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
