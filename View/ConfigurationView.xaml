<UserControl x:Class="LABB_3.View.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:view="clr-namespace:LABB_3.View">
    <Grid>

        <!-- ==================== PAGE 0: start page ==================== -->
        <view:HomeView Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}"/>

        <!-- ==================== PAGE 1: question packs ==================== -->
        <!-- From Play: only the green play button. From Settings: only the pen, and a click opens the questions. -->
        <Border Style="{StaticResource Card}" Padding="26" MaxWidth="780"
                Visibility="{Binding IsPacksPage, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="16,8" FontSize="14"
                            ToolTip="Create a new question pack (Ctrl+N)"
                            Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVis}}"
                            Command="{Binding Main.NewPackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" Margin="0,0,6,0"/>
                            <TextBlock Text="New Pack"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="44" Height="44" Margin="0,0,14,0"
                            Background="{StaticResource SoftGrayBrush}" ToolTip="Back to the start page"
                            Command="{Binding GoHomeCommand}">
                        <fa:IconBlock Icon="ArrowLeft" FontSize="18" Foreground="{StaticResource NavyBrush}"/>
                    </Button>
                    <fa:IconBlock Icon="BookOpen" FontSize="24" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding PacksPageTitle}" Style="{StaticResource Heading}"/>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextBrush}"
                           Text="{Binding PacksPageTip}" TextWrapping="Wrap"/>

                <ListBox ItemsSource="{Binding Main.Packs}" SelectedItem="{Binding Main.ActivePack}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole row is a button: in Settings a click opens the questions of this pack -->
                            <Button Command="{Binding DataContext.OpenPackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>

                                <DockPanel Background="Transparent">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <!-- Play page: only this button -->
                                        <Button Style="{StaticResource IconButton}" Background="{StaticResource GreenBrush}"
                                                ToolTip="Play (every question needs a text and 4 answers)" ToolTipService.ShowOnDisabled="True"
                                                Visibility="{Binding DataContext.IsChoosingPackToPlay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.Main.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <fa:IconBlock Icon="Play"/>
                                        </Button>
                                        <!-- Settings page: only the pen -->
                                        <Button Style="{StaticResource IconButton}" Background="{StaticResource PurpleBrush}"
                                                ToolTip="Show and edit the questions"
                                                Visibility="{Binding DataContext.IsSettingsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.OpenPackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <fa:IconBlock Icon="Pen"/>
                                        </Button>
                                    </StackPanel>

                                    <fa:IconBlock Icon="Book" FontSize="30" Foreground="{StaticResource OrangeBrush}"
                                                  Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource NavyBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                                            <Run Text="{Binding Difficulty, Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding Questions.Count, Mode=OneWay}"/>
                                            <Run Text="questions"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== PAGE 2: questions in the active pack ==================== -->
        <Border Style="{StaticResource Card}" Padding="26" MaxWidth="780"
                Visibility="{Binding IsQuestionsPage, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- Header: back arrow, pack name, buttons -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button Style="{StaticResource IconButton}" Width="44" Height="44" Margin="0,0,14,0"
                            Background="{StaticResource SoftGrayBrush}" ToolTip="Back to the question packs"
                            Command="{Binding BackToPacksCommand}">
                        <fa:IconBlock Icon="ArrowLeft" FontSize="18" Foreground="{StaticResource NavyBrush}"/>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Background="{StaticResource PurpleBrush}"
                                ToolTip="Pack options (Ctrl+O)"
                                Command="{Binding Main.PackOptionsCommand}">
                            <fa:IconBlock Icon="Gear"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Add question (Insert)"
                                Command="{Binding AddQuestionCommand}">
                            <fa:IconBlock Icon="Plus"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Main.ActivePack.Name}" Style="{StaticResource Heading}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                            <Run Text="{Binding Main.ActivePack.Difficulty, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding Main.ActivePack.Questions.Count, Mode=OneWay}"/>
                            <Run Text="questions ·"/>
                            <Run Text="{Binding Main.ActivePack.TimeLimitInSeconds, Mode=OneWay}"/>
                            <Run Text="seconds per question"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextBrush}"
                           Text="Tip: click the pen to edit · Insert = add question · Delete = remove question · Ctrl+O = pack options"
                           TextWrapping="Wrap"/>

                <ListBox ItemsSource="{Binding Main.ActivePack.Questions}" SelectedItem="{Binding ActiveQuestion}"
                         Background="Transparent" BorderThickness="0" FontSize="15"
                         Foreground="{StaticResource NavyBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Background="{StaticResource PurpleBrush}" ToolTip="Edit question"
                                        Command="{Binding DataContext.EditQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <fa:IconBlock Icon="Pen"/>
                                </Button>
                                <TextBlock Text="{Binding Query}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== PAGE 3: edit one question ==================== -->
        <Border Style="{StaticResource Card}" Padding="30" MaxWidth="780" VerticalAlignment="Top"
                Visibility="{Binding IsEditQuestionPage, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- Header: back arrow + title -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <Button Style="{StaticResource IconButton}" Width="44" Height="44" Margin="0,0,14,0"
                            Background="{StaticResource SoftGrayBrush}" ToolTip="Back to the question list"
                            Command="{Binding BackToListCommand}">
                        <fa:IconBlock Icon="ArrowLeft" FontSize="18" Foreground="{StaticResource NavyBrush}"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Main.ActivePack.Name}" FontSize="13"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <fa:IconBlock Icon="Pen" FontSize="22" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Edit Question" Style="{StaticResource Heading}"/>
                </DockPanel>

                <!-- Bottom: delete + save -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding SaveCommand}"
                            ToolTip="Save and go back to the list (needs a question and 4 answers)" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FloppyDisk" Margin="0,0,8,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PillButton}"
                            Background="{StaticResource SoftPinkBrush}" Foreground="#E5484D"
                            Command="{Binding RemoveQuestionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="TrashCan" Margin="0,0,8,0"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- The form -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Question:" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,18"
                             Text="{Binding ActiveQuestion.Query, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Answers (select the correct one):" Style="{StaticResource Label}"/>

                    <RadioButton Grid.Row="3" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[0], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="4" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[1], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="5" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[2], UpdateSourceTrigger=PropertyChanged}"/>

                    <RadioButton Grid.Row="6" IsChecked="{Binding ActiveQuestion.CorrectIndex, Converter={StaticResource IndexToBool}, ConverterParameter=3}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ActiveQuestion.Answers[3], UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
